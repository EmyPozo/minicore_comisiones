<%= form_with(model: regla) do |form| %>
  <% if regla.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(regla.errors.count, "error") %> prohibited this regla from being saved:</h2>

      <ul>
        <% regla.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
